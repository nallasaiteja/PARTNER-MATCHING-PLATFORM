// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------
// ORGANIZATIONS & LOCATIONS
// ---------------------------------------------------------

enum OrgType {
  HQ
  BRANCH
  FRANCHISE
}

enum LocationLevel {
  COUNTRY
  STATE
  DISTRICT
  MANDAL
  VILLAGE
}

enum CommunityMasterLevel {
  RELIGION
  CASTE
  SUB_CASTE
  STAR
  MOON_SIGN
  PADAM
  GOTHRAM
}

model CommunityMaster {
  id        String              @id @default(uuid())
  name      String
  level     CommunityMasterLevel
  parentId  String?
  parent    CommunityMaster?    @relation("CommunityHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  CommunityMaster[]   @relation("CommunityHierarchy")
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([parentId, level, name])
  @@index([parentId, level, isActive])
}

model LocationMaster {
  id        String        @id @default(uuid())
  name      String
  level     LocationLevel
  parentId  String?
  parent    LocationMaster?  @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  LocationMaster[] @relation("LocationHierarchy")
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([parentId, level, name])
  @@index([parentId, level, isActive])
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  type      OrgType
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  memberProfiles MemberProfile[]
}

model PlatformSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------
// ROLES & USERS (STAFF + ADMIN)
// ---------------------------------------------------------

enum RoleType {
  SUPER_ADMIN
  ADMIN
  HQ_SERVICE_TEAM
  BRANCH_MANAGER
  BRANCH_STAFF
  BRANCH_AGENT
  FRANCHISE_MANAGER
  FRANCHISE_STAFF
  FRANCHISE_AGENT
  MEMBER
}

enum StaffStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
  TERMINATED
}

enum StaffDivision {
  FREE_TEAM
  HQ_SERVICE_TEAM
  NOT_APPLICABLE // for admins, managers, members
}

model User {
  id             String        @id @default(uuid())
  email          String?       @unique
  mobile         String        @unique
  passwordHash   String
  role           RoleType
  status         StaffStatus   @default(ACTIVE)
  staffDivision  StaffDivision @default(NOT_APPLICABLE)

  mobileVerified             Boolean   @default(false)
  emailVerified              Boolean   @default(false)
  mobileOtpHash              String?
  mobileOtpExpiresAt          DateTime?
  mobileOtpSentAt             DateTime?
  mobileOtpFailedAttempts     Int       @default(0)
  emailOtpHash               String?
  emailOtpExpiresAt           DateTime?
  emailOtpSentAt              DateTime?
  emailOtpFailedAttempts      Int       @default(0)
  passwordResetTokenHash      String?
  passwordResetExpiresAt      DateTime?
  passwordResetRequestedAt    DateTime?

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  // Who created this staff account (for audit trail)
  createdById    String?
  createdBy      User?         @relation("CreatedByRelation", fields: [createdById], references: [id])
  createdUsers   User[]        @relation("CreatedByRelation")

  // Permission overrides (e.g., FREE_TEAM granted access to paid profiles)
  permissionOverrides Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberProfile  MemberProfile?
  auditLogs      AuditLog[]        @relation("ActorLogs")
  blockedMembers MemberProfile[]   @relation("BlockedByStaff")
  createdProfiles MemberProfile[]  @relation("CreatedByStaff")
  assignedProfiles MemberProfile[] @relation("AssignedProfiles")

  @@index([role])
  @@index([status])
  @@index([organizationId])
}

// ---------------------------------------------------------
// MEMBERS
// ---------------------------------------------------------

enum MemberPackageType {
  FREE
  PAID
}

enum MemberOwnershipType {
  BRANCH
  FRANCHISE
  HQ
}

model MemberProfile {
  id          String   @id @default(uuid())
  memberId    String?  @unique // Human-readable ID e.g. M2026001
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])

  // --- Step 1: Personal Details ---
  firstName   String
  lastName    String
  gender      String
  dateOfBirth DateTime

  // Step 1 - Photo & Identity
  photoUrl        String?   // URL to stored profile photo
  photoFilename   String?   // filename on disk/storage
  idProofType     String?   // e.g. 'Aadhar Card', 'Passport'
  idProofNumber   String?   // actual ID proof number (for search)
  idProofFileUrl  String?   // URL to uploaded ID proof document
  timeOfBirth     String?   // Optional HH:MM (24h)
  birthPlace      String?   // Optional text

  // Package & Ownership
  packageType    MemberPackageType   @default(FREE)
  ownershipType  MemberOwnershipType @default(BRANCH)
  ownerOrgId     String?             // The branch/franchise/HQ org that owns this profile
  ownerOrg       Organization?       @relation(fields: [ownerOrgId], references: [id])

  // Who originally created this profile (agent/staff)
  createdByStaffId String?
  createdByStaff   User?   @relation("CreatedByStaff", fields: [createdByStaffId], references: [id])

  // Staff assigned to this profile
  assignedToId     String?
  assignedTo       User?   @relation("AssignedProfiles", fields: [assignedToId], references: [id])

  // The original branch/franchise org (retained for commission record after HQ transfer)
  originatingOrgId String?

  // Block tracking
  isBlocked    Boolean   @default(false)
  blockedById  String?
  blockedBy    User?     @relation("BlockedByStaff", fields: [blockedById], references: [id])
  blockedAt    DateTime?
  blockedReason String?

  // Form progress tracking
  currentStep    Int   @default(1)  // Which step the user is currently on
  completedSteps Json? // e.g. [1, 2, 3] — array of completed step numbers

  // Catch-all for additional data not yet given their own columns
  profileData Json?

  // Section 4: Terms & Package Entitlements
  termsAccepted          Boolean   @default(false)
  termsAcceptedAt        DateTime?
  createdByType          String    @default("MEMBER") // "MEMBER" or "STAFF"
  packageExpiresAt       DateTime?
  contactsRevealedCount  Int       @default(0)
  contactsQuota          Int       @default(0)
  currentPackageId       String?
  currentPackage         PackageMaster? @relation(fields: [currentPackageId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salesCommissionRecords SalesCommissionRecord[]
  supportTickets         SupportTicket[]
  sentInterests          MemberInterest[]        @relation("SentInterests")
  receivedInterests      MemberInterest[]        @relation("ReceivedInterests")
  sentRevealRequests     ContactRevealRequest[]  @relation("SentRevealRequests")
  receivedRevealRequests ContactRevealRequest[]  @relation("ReceivedRevealRequests")
  shortlists             MemberShortlist[]       @relation("MemberShortlists")
  blocklists             MemberBlocklist[]       @relation("MemberBlocklists")
  viewedProfiles         ProfileViewLog[]        @relation("ViewedProfiles")
  profileViewers         ProfileViewLog[]        @relation("ProfileViewers")
  invoices               MemberInvoice[]

  @@index([ownerOrgId])
  @@index([ownershipType])
  @@index([createdByStaffId])
  @@index([packageType])
  @@index([isBlocked])
  @@index([memberId])
}

// ---------------------------------------------------------
// SALES & COMMISSION RECORD (read-only for originating agent)
// ---------------------------------------------------------

model SalesCommissionRecord {
  id              String   @id @default(uuid())
  memberProfileId String
  memberProfile   MemberProfile @relation(fields: [memberProfileId], references: [id])
  agentId         String
  originatingOrgId String?
  commissionNotes String?
  createdAt       DateTime @default(now())

  @@index([agentId])
  @@index([memberProfileId])
}

// ---------------------------------------------------------
// SUPPORT TICKETS (HQ Service Team)
// ---------------------------------------------------------

enum TicketStatus {
  OPEN
  PENDING_OTP
  OTP_VERIFIED
  CLOSED
}

model SupportTicket {
  id              String       @id @default(uuid())
  memberProfileId String
  memberProfile   MemberProfile @relation(fields: [memberProfileId], references: [id])

  subject         String
  description     String?
  status          TicketStatus @default(OPEN)

  // OTP for closure verification
  closureOtp      String?
  closureOtpSentAt DateTime?
  closureOtpVerifiedAt DateTime?

  assignedToId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([memberProfileId])
}

// ---------------------------------------------------------
// AUDIT & LOGGING
// ---------------------------------------------------------

enum AuditAction {
  LOGIN
  LOGOUT
  PROFILE_VIEW
  PROFILE_CREATE
  PROFILE_EDIT
  PROFILE_BLOCK
  PROFILE_UNBLOCK
  MEMBER_EXPORT
  STAFF_CREATE
  STAFF_EDIT
  STAFF_BLOCK
  STAFF_TERMINATE
  INVOICE_RAISE
  INVOICE_APPROVE
  TICKET_OPEN
  TICKET_CLOSE
  OTP_SENT
  OTP_VERIFIED
  PERMISSION_OVERRIDE
  INTEREST_SENT
  INTEREST_ACCEPTED
  INTEREST_REJECTED
  CONTACT_REVEAL_REQUEST
  CONTACT_REVEALED
  PACKAGE_UPGRADE
}

model AuditLog {
  id           String      @id @default(uuid())
  actorId      String
  actor        User        @relation("ActorLogs", fields: [actorId], references: [id])
  actorRole    RoleType
  action       AuditAction
  resourceType String?     // e.g. "MemberProfile", "User", "SupportTicket"
  resourceId   String?
  orgId        String?
  metadata     Json?
  ipAddress    String?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

// ---------------------------------------------------------
// SECTION 4: PACKAGES, INTERESTS, CONTACT REVEALS, ACTIVITY
// ---------------------------------------------------------

model PackageMaster {
  id                     String          @id @default(uuid())
  name                   String          @unique // e.g. "Silver", "Gold", "Platinum", "Diamond"
  validityDays           Int
  contactReveals         Int
  ticketQuota            Int             @default(5)
  emiEligible            Boolean         @default(false)
  cost                   Float
  servicesProvided       String
  featuredProfileEligible Boolean        @default(false)
  isActive               Boolean         @default(true)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  memberProfiles         MemberProfile[]
  invoices               MemberInvoice[]
}

model MemberInterest {
  id                String        @id @default(uuid())
  senderProfileId   String
  sender            MemberProfile @relation("SentInterests", fields: [senderProfileId], references: [id], onDelete: Cascade)
  receiverProfileId String
  receiver          MemberProfile @relation("ReceivedInterests", fields: [receiverProfileId], references: [id], onDelete: Cascade)
  status            String        @default("PENDING") // PENDING, ACCEPTED, REJECTED
  actionDate        DateTime?
  actionById        String?       // Member or Staff ID
  actionByType      String?       // "MEMBER" or "STAFF"
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([senderProfileId, receiverProfileId])
  @@index([senderProfileId])
  @@index([receiverProfileId])
  @@index([status])
}

model ContactRevealRequest {
  id                String        @id @default(uuid())
  senderProfileId   String
  sender            MemberProfile @relation("SentRevealRequests", fields: [senderProfileId], references: [id], onDelete: Cascade)
  receiverProfileId String
  receiver          MemberProfile @relation("ReceivedRevealRequests", fields: [receiverProfileId], references: [id], onDelete: Cascade)
  revealType        String        // "AUTO", "SCHEDULED_24H", "SCHEDULED_72H", "REQUEST_ACCEPTANCE"
  status            String        @default("PENDING") // "PENDING", "ACCEPTED", "REJECTED", "BLOCKED", "REVEALED"
  unlocksAt         DateTime?
  revealedAt        DateTime?
  actionDate        DateTime?
  actionById        String?       // Member ID or Staff ID
  actionByType      String?       // "MEMBER" or "STAFF"
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([senderProfileId, receiverProfileId])
  @@index([senderProfileId])
  @@index([receiverProfileId])
  @@index([status])
}

model MemberShortlist {
  id              String        @id @default(uuid())
  memberProfileId String
  memberProfile   MemberProfile @relation("MemberShortlists", fields: [memberProfileId], references: [id], onDelete: Cascade)
  targetProfileId String
  createdAt       DateTime      @default(now())

  @@unique([memberProfileId, targetProfileId])
  @@index([memberProfileId])
}

model MemberBlocklist {
  id              String        @id @default(uuid())
  memberProfileId String
  memberProfile   MemberProfile @relation("MemberBlocklists", fields: [memberProfileId], references: [id], onDelete: Cascade)
  targetProfileId String
  createdAt       DateTime      @default(now())

  @@unique([memberProfileId, targetProfileId])
  @@index([memberProfileId])
}

model ProfileViewLog {
  id              String        @id @default(uuid())
  viewerProfileId String
  viewer          MemberProfile @relation("ViewedProfiles", fields: [viewerProfileId], references: [id], onDelete: Cascade)
  viewedProfileId String
  viewed          MemberProfile @relation("ProfileViewers", fields: [viewedProfileId], references: [id], onDelete: Cascade)
  viewedAt        DateTime      @default(now())

  @@index([viewerProfileId])
  @@index([viewedProfileId])
}

model MemberInvoice {
  id              String        @id @default(uuid())
  invoiceNumber   String        @unique
  memberProfileId String
  memberProfile   MemberProfile @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)
  packageId       String
  package         PackageMaster @relation(fields: [packageId], references: [id])
  amount          Float
  paymentMode     String        // "ONLINE", "UPI", "CARD", "EMI", "CASH"
  status          String        @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  notes           String?
  createdAt       DateTime      @default(now())

  @@index([memberProfileId])
  @@index([status])
}

