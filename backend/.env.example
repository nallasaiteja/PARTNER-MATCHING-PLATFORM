# ==============================================================================
# PARTNER MATCHING PLATFORM — BACKEND CONFIGURATION TEMPLATE (.env.example)
# Note: Never commit production credentials, secrets, or certificates to git!
# ==============================================================================

# Database Connection Strings (Supabase PostgreSQL)
# Connect to Supabase via connection pooling with Supavisor (Port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection to the database. Used for Prisma migrations (Port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Authentication & Session Secrets (Change in production to >=32-char cryptographically secure keys)
JWT_SECRET="generate-a-strong-32-byte-hex-secret-for-jwt"
JWT_REFRESH_SECRET="generate-a-strong-32-byte-hex-secret-for-refresh-jwt"
SESSION_INACTIVITY_TIMEOUT_MINUTES=30

# Application Server Configuration
PORT=3000
NODE_ENV="development"
ALLOWED_ORIGINS="http://localhost:5173,https://yourmatrimonydomain.com"

# Supabase Auth & Storage API
# Project URL: Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
# Service Role Key: Found in Supabase Dashboard -> Project Settings -> API -> service_role key
# (Server-only secret key, never commit to git or expose to client apps)
SUPABASE_SECRET_KEY="your-supabase-service-role-secret-key"

# External Notification & Communications Gateways (Optional: Safe simulated dev mode if omitted)
SMS_PROVIDER_WEBHOOK_URL=""
EMAIL_PROVIDER_WEBHOOK_URL=""
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Office Hours for Automated Staff Login Attendance Calculation
OFFICE_START_TIME="09:30"
OFFICE_END_TIME="18:30"
