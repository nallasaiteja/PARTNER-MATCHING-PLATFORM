# ==============================================================================
# PARTNER MATCHING PLATFORM — FRONTEND CONFIGURATION TEMPLATE (.env.example)
# Note: Never put secret service-role keys or database credentials in frontend!
# ==============================================================================

# Backend API Endpoint
VITE_API_BASE_URL="http://localhost:3000"

# Supabase Client Configuration (Public Anon Key only)
# Project URL: Found in Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://[PROJECT-REF].supabase.co"

# Supabase Anon / Publishable Key: Safe for browser use with Row Level Security enabled
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-publishable-key"

# Marketing & Tracking Integration (Optional: Disabled/dev mode if omitted)
VITE_FACEBOOK_PIXEL_ID=""
