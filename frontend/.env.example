# Supabase Client Configuration (Frontend)
# Project URL: Found in Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://[PROJECT-REF].supabase.co"

# Supabase Anon / Publishable Key: Found in Supabase Dashboard -> Project Settings -> API -> anon public key
# (Safe for browser use with Row Level Security enabled)
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-publishable-key"
